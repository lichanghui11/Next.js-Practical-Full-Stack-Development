model Category {
  // 这里生成的是标准的 UUID v4 格式，只有小写字母
  // Radix UI 的 Command 组件在内部处理 value 时会自动 toLowerCase()，所以 onSelect 收到的 currentValue 是全小写的
  // 这里的全小写 ID 方便了这个组件的使用
  id       String @id @default(uuid())
  name     String @unique
  slug     String @unique
  // 模型中的 path depth numchild 这三个字段必须使用这个名字，这个是为了方便 withBark 插件识别
  path     String @unique
  depth    Int
  numchild Int    @default(0)
  posts    Post[]

  @@index([path])
  @@map("categories")
}
