{
  "name": "esti-react-blog",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#tailwind.css": "./src/app/styles/tailwind.css"
  },
  "scripts": {
    "dev": "rimraf -rf .next && next dev",
    "build": "rimraf -rf .next && next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "add-shadcn": "pnpm dlx shadcn@latest add",
    "-----------------": "--------------------database commands-----------------------------",
    "cross-env命令的作用": "解决macOS和Windows系统环境变量不一致的问题-----------------------------",
    "=== Prisma Client ===": "================================ 生成客户端 ====================",
    "db:generate": "cross-env NODE_ENV=development prisma generate",
    "=== 开发环境 ===": "================================ 数据库迁移 ==========================",
    "db:dev:migrate": "cross-env NODE_ENV=development prisma migrate dev",
    "db:dev:push": "cross-env NODE_ENV=development prisma db push",
    "db:dev:reset": "cross-env NODE_ENV=development prisma migrate reset -f",
    "db:dev:seed": "cross-env NODE_ENV=development prisma db seed",
    "=== 生产环境 ===": "================================ 生成生产环境数据库 ====================",
    "db:prod:deploy": "cross-env NODE_ENV=production prisma migrate deploy",
    "---在线预览工具---": "-------------------------------------------------",
    "db:studio": "prisma studio",
    "-------docker------": "--------------------docker commands-----------------------------",
    "infra:up": "docker compose -f docker-compose.yml up -d",
    "infra:down": "docker compose -f docker-compose.yml down",
    "infra:logs": "docker compose -f docker-compose.yml logs -f",
    "infra:ps": "docker compose -f docker-compose.yml ps",
    "infra:reset": "docker compose -f docker-compose.yml down -v && docker compose -f docker-compose.yml up -d"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} -r tsconfig-paths/register src/database/seed/index.ts"
  },
